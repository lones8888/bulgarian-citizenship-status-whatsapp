{
  "manifest_version": 3,
  "name": "Bulgaristan Vatandaşlık Takip",
  "version": "1.2.7",
  "key": "",
  "description": "En fazla 10 başvuru için istediğiniz aralıkta otomatik takip ve WhatsApp bildirimi.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://publicbg.mjs.bg/BgInfo/Home/Enroll*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Başvurularım",
    "default_icon": "icon128.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
